# Cloud MySQL for Vercel (copy to .env.vercel — gitignored)
# Get free MySQL: https://vercel.com/marketplace/tidb-cloud → Connect Account → link apex-infinite

DB_HOST=your-cluster.gateway.region.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_user.root
DB_PASSWORD=your_password
DB_NAME=apex
DB_SSL=true
DB_CONNECTION_LIMIT=2
APEX_ALLOW_DEV_OTP=true
