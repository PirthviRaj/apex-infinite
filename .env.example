# Apex Infinite — Environment

# MySQL (local or cloud — Vercel needs a public cloud MySQL host)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=apex
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_CONNECTION_LIMIT=2

# Phone OTP — local delivery without Twilio (OTP stored in MySQL + shown in UI)
APEX_ALLOW_DEV_OTP=true

# Phone OTP — real SMS (optional). When set, SMS is sent and devOtp is not returned.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Social OAuth (optional)
# GOOGLE_CLIENT_ID=
# GITHUB_CLIENT_ID=
# APPLE_CLIENT_ID=
